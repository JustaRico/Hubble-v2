# Hubble 2.0 — copy to .env and adjust. All values are single-machine defaults.
# Secrets: replace before any real deployment; .env is gitignored.

# ── shared ──
HUBBLE_NET_SUBNET=172.31.99.0/24

# ── Phase 1: copyparty DMZ ──
DMZ_PORT=13923
DMZ_USER=hubble
DMZ_PASS=hubble-dev-pass

# ── Phase 2: llama-swap (EXISTING container this run; installer creates it on
#    fresh machines). Host port of the existing llama-swap deployment.
LLAMA_SWAP_URL=http://host.docker.internal:10123

# ── Phase 3: LiteLLM ──
LITELLM_PORT=14000
OPENROUTER_API_KEY=
# key required by plugins/clients to call the gateway (dev value)
LITELLM_MASTER_KEY=sk-hubble-dev-master
# llama-swap as seen from inside the LiteLLM container
LITELLM_LLAMA_SWAP_URL_V1=http://host.docker.internal:10123/v1

# ── Phase 4: aux services (non-default ports; SearXNG/Firecrawl instances on
#    8080/3002 already belong to other tooling this run) ──
SEARXNG_PORT=8180
MCPHUB_PORT=13100
# fixed JWT secret so test/tooling can mint tokens; dev value
MCPHUB_JWT_SECRET=hubble-dev-jwt-secret
# Firecrawl is reused from the existing deployment this run:
FIRECRAWL_URL=http://host.docker.internal:3002

# ── Phase 5: Wake Gateway ──
WAKE_GW_PORT=8811
# true while everything runs on one machine: skip real Wake-on-LAN, exercise
# health-check/coalescing/proxy logic only.
SAME_HOST_MODE=true
WORKSTATION_MAC=
WORKSTATION_BROADCAST=255.255.255.255

# ── Phase 6: DSH ──
# renamed: DSH_ prefix is reserved by the dsh launcher; pass --port instead
HUBBLE_DSH_PORT=3080
DSH_BASIC_AUTH_B64=
